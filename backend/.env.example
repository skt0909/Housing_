FLASK_ENV=development

# MySQL database configuration (required for production on Railway)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=h_db

# Path to the directory containing clean_data.db and borough_data.db
# Default in dev: auto-detected relative to this repo
# On Railway/Render: not needed when using MySQL
DATA_DIR=
